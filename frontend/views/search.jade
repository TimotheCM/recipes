extends layout

block content
  h1 Results for "#{query}"

  if results && results.length > 0
    ul
      each recipe in results
        li
          a(href="/recipe/" + encodeURIComponent(recipe.title), target="_blank", rel="noopener noreferrer")= recipe.title
  else
    p No results found.

  p
    a(href="/")  Back to home page
